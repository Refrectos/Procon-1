<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PRoCon.UI.Views.PlayerActionsPanel"
             Background="{DynamicResource BackgroundBrush}"
             MinWidth="220" MaxWidth="320">

  <DockPanel>

    <!-- Player Info Header -->
    <Border DockPanel.Dock="Top"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            CornerRadius="3" Padding="10" Margin="0,0,0,6">
      <StackPanel Spacing="6">
        <!-- Player name + clear button -->
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="X" FontSize="9" Padding="4,1" CornerRadius="3"
                  Background="Transparent" Foreground="{DynamicResource TextDisabledBrush}"
                  Click="OnClearSelection" ToolTip.Tip="Clear selection" />
          <TextBlock Name="PlayerNameText" Text="No player selected"
                     FontSize="14" FontWeight="Bold"
                     Foreground="{DynamicResource PrimaryBrush}"
                     TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <!-- Location row: flag + country + threat badge -->
        <StackPanel Name="LocationRow" Orientation="Horizontal" Spacing="6" IsVisible="False">
          <Image Name="PlayerFlagImage" Width="18" Height="12" VerticalAlignment="Center" />
          <TextBlock Name="PlayerCountryText" Text="" FontSize="10"
                     Foreground="#a0a8b8" VerticalAlignment="Center" />
          <Border Name="ThreatBadge" CornerRadius="3" Padding="5,1" VerticalAlignment="Center"
                  Background="#4a2d2d" IsVisible="False">
            <TextBlock Name="PlayerThreatText" Text="" FontSize="9" FontWeight="Bold"
                       Foreground="{DynamicResource ErrorBrush}" />
          </Border>
        </StackPanel>

        <!-- IP address -->
        <TextBlock Name="PlayerIPText" Text="" FontSize="9"
                   Foreground="#8888aa" FontFamily="Consolas,monospace" />

        <!-- Stats grid -->
        <Grid ColumnDefinitions="*,*,*,*" Margin="0,2,0,0">
          <StackPanel Grid.Column="0" HorizontalAlignment="Center">
            <TextBlock Text="SCORE" FontSize="8" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextDisabledBrush}" HorizontalAlignment="Center" />
            <TextBlock Name="PlayerScoreText" Text="--" FontSize="13" FontWeight="Bold"
                       Foreground="{DynamicResource ScoreBrush}" HorizontalAlignment="Center" />
          </StackPanel>
          <StackPanel Grid.Column="1" HorizontalAlignment="Center">
            <TextBlock Text="K/D" FontSize="8" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextDisabledBrush}" HorizontalAlignment="Center" />
            <TextBlock Name="PlayerKDText" Text="--" FontSize="13" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" />
          </StackPanel>
          <StackPanel Grid.Column="2" HorizontalAlignment="Center">
            <TextBlock Text="PING" FontSize="8" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextDisabledBrush}" HorizontalAlignment="Center" />
            <TextBlock Name="PlayerPingText" Text="--" FontSize="13" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" />
          </StackPanel>
          <StackPanel Grid.Column="3" HorizontalAlignment="Center">
            <TextBlock Text="SQUAD" FontSize="8" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextDisabledBrush}" HorizontalAlignment="Center" />
            <TextBlock Name="PlayerSquadText" Text="--" FontSize="13" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" />
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>

    <!-- Message / Reason + Actions -->
    <Border DockPanel.Dock="Top"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            CornerRadius="3" Padding="10" Margin="0,0,0,6">
      <StackPanel Spacing="6">
        <TextBlock Name="MessageReasonLabel" Text="MESSAGE / REASON" FontSize="8" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextDisabledBrush}" />
        <TextBox Name="MessageInput" Watermark="Message or reason..."
                 Background="{DynamicResource InputBackgroundBrush}"
                 Foreground="{DynamicResource TextPrimaryBrush}"
                 BorderBrush="{DynamicResource BorderBrush}"
                 FontSize="11" Height="45"
                 AcceptsReturn="True" TextWrapping="Wrap" />

        <Border Background="{DynamicResource BorderBrush}" Height="1" Margin="0,2" />

        <TextBlock Name="ActionsLabel" Text="ACTIONS" FontSize="8" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextDisabledBrush}" />
        <UniformGrid Columns="2" Margin="0,2,0,0">
          <Button Name="SayButton" Content="SAY ALL" Margin="0,0,2,0"
                  Background="#2a2a45" Foreground="#a0a8b8"
                  Padding="0,6" CornerRadius="4" FontSize="10" FontWeight="SemiBold"
                  HorizontalContentAlignment="Center" Click="OnSayPlayer" />
          <Button Name="YellButton" Content="YELL ALL" Margin="2,0,0,0"
                  Background="#4a3a1a" Foreground="#ffd740"
                  Padding="0,6" CornerRadius="4" FontSize="10" FontWeight="SemiBold"
                  HorizontalContentAlignment="Center" Click="OnYellPlayer" />
        </UniformGrid>
        <UniformGrid Columns="2">
          <Button Name="KillButton" Content="KILL" Margin="0,0,2,0"
                  Background="#3a1a1a" Foreground="#ef5350"
                  Padding="0,6" CornerRadius="4" FontSize="10" FontWeight="SemiBold"
                  HorizontalContentAlignment="Center" Click="OnKillPlayer" />
          <Button Name="KickButton" Content="KICK" Margin="2,0,0,0"
                  Background="#4a3a1a" Foreground="#ffd740"
                  Padding="0,6" CornerRadius="4" FontSize="10" FontWeight="SemiBold"
                  HorizontalContentAlignment="Center" Click="OnKickPlayer" />
        </UniformGrid>

        <Border Background="{DynamicResource BorderBrush}" Height="1" Margin="0,2" />

        <TextBlock Name="MoveToTeamLabel" Text="MOVE TO TEAM" FontSize="8" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextDisabledBrush}" />
        <DockPanel>
          <TextBox DockPanel.Dock="Right" Name="MoveSquadIdInput" Text="0" Width="30"
                   Background="{DynamicResource InputBackgroundBrush}"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   BorderBrush="{DynamicResource BorderBrush}"
                   FontSize="10" Padding="4,3" Margin="4,0,0,0" />
          <TextBlock DockPanel.Dock="Right" Text="Sq:" FontSize="10"
                     Foreground="{DynamicResource TextDisabledBrush}"
                     VerticalAlignment="Center" Margin="6,0,0,0" />
          <UniformGrid Columns="4">
            <Button Content="1" Margin="0,0,2,0" Padding="0,5" CornerRadius="3" Width="28"
                    FontSize="10" FontWeight="SemiBold" HorizontalContentAlignment="Center"
                    Background="#2a2a45" Foreground="#a0a8b8" Click="OnMoveTeam1" />
            <Button Content="2" Margin="0,0,2,0" Padding="0,5" CornerRadius="3" Width="28"
                    FontSize="10" FontWeight="SemiBold" HorizontalContentAlignment="Center"
                    Background="#2a2a45" Foreground="#a0a8b8" Click="OnMoveTeam2" />
            <Button Content="3" Margin="0,0,2,0" Padding="0,5" CornerRadius="3" Width="28"
                    FontSize="10" FontWeight="SemiBold" HorizontalContentAlignment="Center"
                    Background="#2a2a45" Foreground="#a0a8b8" Click="OnMoveTeam3" />
            <Button Content="4" Padding="0,5" CornerRadius="3" Width="28"
                    FontSize="10" FontWeight="SemiBold" HorizontalContentAlignment="Center"
                    Background="#2a2a45" Foreground="#a0a8b8" Click="OnMoveTeam4" />
          </UniformGrid>
        </DockPanel>

        <Border Background="{DynamicResource BorderBrush}" Height="1" Margin="0,2" />

        <TextBlock Name="BanLabel" Text="BAN" FontSize="8" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextDisabledBrush}" />
        <StackPanel Orientation="Horizontal" Spacing="10">
          <RadioButton Name="BanPermanentRadio" Content="Perm" GroupName="BanType"
                       IsChecked="True" FontSize="10"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
          <RadioButton Name="BanTemporaryRadio" Content="Temp" GroupName="BanType"
                       FontSize="10"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
          <RadioButton Name="BanRoundRadio" Content="Round" GroupName="BanType"
                       FontSize="10"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Name="MinutesLabel" Text="Minutes:" FontSize="10"
                     Foreground="{DynamicResource TextDisabledBrush}" VerticalAlignment="Center" />
          <TextBox Name="BanDurationInput" Text="60" Width="50"
                   Background="{DynamicResource InputBackgroundBrush}"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   BorderBrush="{DynamicResource BorderBrush}"
                   FontSize="10" Padding="4,3" />
        </StackPanel>
        <Button Name="BanPlayerButton" Content="BAN PLAYER"
                Background="#3a1a1a" Foreground="#ef5350"
                Padding="0,6" CornerRadius="4" FontSize="10" FontWeight="SemiBold"
                HorizontalContentAlignment="Center" HorizontalAlignment="Stretch"
                Click="OnBanPlayer" />
      </StackPanel>
    </Border>

    <!-- Status -->
    <TextBlock Name="ActionStatusText" Text=""
               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"
               TextWrapping="Wrap" Margin="4,2" />
  </DockPanel>
</UserControl>
